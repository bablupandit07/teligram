# Dependencies
# Publish only standalone web app files. Everything else stays local.
/*
!/.gitignore
!/app-server.js
!/telegram-view.js
!/telegram.html
!/package.json
!/package-lock.json
!/README.md
!/render.yaml
!/.env.example
node_modules/

# Local JSON data and caches (keep dependency manifests)
*.json
!package.json
!package-lock.json

videos/
diskwala/
videosdisk/
videos_50_200MBviral/
videos_50_200MB/
# Environment
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Build
dist/
build/
.next/
.nuxt/
.output/

# Cache
.cache/
.parcel-cache/
.vite/

# Coverage
coverage/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Runtime
*.pid
*.seed
*.pid.lock

# Temporary
tmp/
temp/
